# Public — safe to expose to the browser (this is how Supabase's anon key model works:
# it's scoped down entirely by Row Level Security, so it is not a secret by design).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Site URL used to build email-confirmation / password-reset redirect links,
# checkout success/cancel URLs, and share-link URLs. Public by nature.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefixed with NEXT_PUBLIC_, never imported into any
# "use client" file. Required for the app to function; put real values only
# in .env.local (never commit that file) or your host's environment settings.
# ---------------------------------------------------------------------------

# Bypasses RLS entirely. Used only inside lib/supabase/service-role.ts,
# imported only by the billing webhook/cron routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI features — used only inside lib/ai/providers/*.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
ANTHROPIC_MODEL=claude-sonnet-4-6

# Billing (Moyasar) — used only inside lib/billing/providers/* and
# app/api/billing/webhook/route.ts.
PAYMENT_PROVIDER=moyasar
MOYASAR_SECRET_KEY=YOUR-MOYASAR-SECRET-KEY
MOYASAR_WEBHOOK_SECRET=YOUR-MOYASAR-WEBHOOK-SECRET

# Recurring-renewal cron job — shared secret checked against the
# x-cron-secret header on app/api/billing/cron/renew-subscriptions.
# Only your scheduler (Vercel Cron / Supabase Scheduled Functions) needs this.
CRON_SECRET=YOUR-RANDOM-CRON-SECRET
